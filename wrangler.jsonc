{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nika-net",
  "main": "dist/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "NIKA_KV" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
